{
  "name": "webhooks-session-store",
  "version": "1.0.0",
  "description": "Durable outbound webhook delivery sessions: HMAC-signed payloads, deterministic exponential backoff with seeded jitter, automatic suspension bookkeeping, replay, receiver-side verification, and a zero-dependency HTTP API",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "webhooks",
    "delivery",
    "retry",
    "backoff",
    "hmac",
    "signing",
    "reliability",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "whs": "./dist/cli-main.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "bun test",
    "demo": "bun run src/cli-main.ts demo",
    "verify:demo": "bun run scripts/verify-demo.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Retsumdk/webhooks-session-store.git"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
